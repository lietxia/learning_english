  {
   "a": "affect",
   "b": "effect",
   "tip": "affect 通常是动词「影响」，effect 通常是名词「效果」。记忆：A=Action(动词)，E=End(结果名词)。"
  },
  {
   "a": "acquire",
   "b": "require",
   "tip": "acquire 获得（经过努力得到），require 要求（需要）。词根都是 quir「寻求」，前缀不同：ac- 向 / re- 回。"
  },
  {
   "a": "conscience",
   "b": "conscious",
   "tip": "conscience 名词「良心」，conscious 形容词「有意识的」。拼写：良心是名词所以结尾 -ence。"
  },
  {
   "a": "adapt",
   "b": "adopt",
   "tip": "adapt 适应（改变自己），adopt 采纳/收养（拿过来）。aDapt 的 D 像调整方向，aDopt 的 D 像拿进来。"
  },
  {
   "a": "principle",
   "b": "principal",
   "tip": "principle 原则（抽象名词），principal 校长/主要的。记忆：规则 principle 带 -le，像 rule。"
  },
  {
   "a": "complement",
   "b": "compliment",
   "tip": "complement 补充物（complete 同源），compliment 赞美（带 i 像 smile）。"
  },
  {
   "a": "imply",
   "b": "infer",
   "tip": "说话人 imply 暗示，听话人 infer 推断。方向不同：一个往外扔，一个往里带。"
  },
  {
   "a": "rise",
   "b": "raise",
   "tip": "rise 不及物「上升」，raise 及物「提高/举起」。rise 自己起来，raise 把东西抬起来。"
  },
  {
   "a": "economic",
   "b": "economical",
   "tip": "economic 经济的（与经济有关），economical 节约的（省钱）。"
  },
  {
   "a": "sensible",
   "b": "sensitive",
   "tip": "sensible 明智的（能判断），sensitive 敏感的（易受刺激）。"
  },
  {
   "a": "historic",
   "b": "historical",
   "tip": "historic 有历史意义的（重大），historical 与历史有关的（泛）。"
  },
